# ==========================================================================
# Template konfigurasi pipeline AI absen_bayu — salin ke .env dan isi.
# .env TIDAK boleh di-commit (sudah di .gitignore). Jangan pernah menaruh
# nilai asli di file ini.
# ==========================================================================

# --- SSH ke hosting produksi (tiffany.my.id) — untuk tunnel MySQL read-only
ABSEN_SSH_HOST=tiffany.my.id
ABSEN_SSH_PORT=2223
ABSEN_SSH_USER=tifx3722
ABSEN_SSH_KEY_PATH=~/.ssh/tiffany_key
ABSEN_SSH_KEY_PASSPHRASE=

# --- MySQL produksi (lewat tunnel; WAJIB user read-only absen_ro)
ABSEN_PROD_DB_HOST=127.0.0.1
ABSEN_PROD_DB_PORT=3306
ABSEN_PROD_DB_NAME=tifx3722_newtiffa_timesheet
ABSEN_PROD_DB_USER=tifx3722_absen_ro
ABSEN_PROD_DB_PASS=

# --- Database pipeline absen_ai (lokal di VPS Hermes)
ABSEN_AI_DB_HOST=127.0.0.1
ABSEN_AI_DB_PORT=3306
ABSEN_AI_DB_NAME=absen_ai
ABSEN_AI_DB_USER=absen_ai
ABSEN_AI_DB_PASS=

# --- Solution Cloud (download .dat) — kredensial per cabang
CLOUD_ATTLOG_SN_SDR=
CLOUD_ATTLOG_SN_GBR=
CLOUD_ATTLOG_USER=
CLOUD_ATTLOG_PASS=

# --- Lokasi runtime
PIPELINE_RAW_DIR=/var/absen_ai/raw
PIPELINE_REPORT_DIR=/var/absen_ai/reports

# --- Opsional: tripwire diff vs simulator Node (kosongkan utk nonaktif)
SIM_API_URL=

# --- Opsional: pengiriman WhatsApp via Hermes (Fase 7)
WA_RECIPIENTS=
